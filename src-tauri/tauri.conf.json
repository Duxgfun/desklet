{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desklet",
  "version": "0.1.0",
  "identifier": "com.duxg.desklet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Desklet",
        "width": 1920,
        "height": 1080,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Duxg",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
